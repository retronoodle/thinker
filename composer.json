{
    "name": "thinker/thinker",
    "description": "A modern Laravel Tinker replacement with enhanced autocomplete and AI assistance",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Thinker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Thinker\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.1",
        "symfony/console": "^6.0",
        "illuminate/container": "^10.0|^11.0",
        "illuminate/database": "^10.0|^11.0",
        "illuminate/events": "^10.0|^11.0",
        "illuminate/filesystem": "^10.0|^11.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "bin": [
        "bin/thinker"
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}